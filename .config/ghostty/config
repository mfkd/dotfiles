# Appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Shell
command = /opt/homebrew/bin/fish --login --interactive

# Selection
copy-on-select = clipboard

# macOS
# Preferred tabs title bar style is not working on macOS 27.
# Restore this setting once an update fixes it.
# macos-titlebar-style = tabs
macos-option-as-alt = left

# Keybindings
keybind = cmd+opt+t=prompt_tab_title
